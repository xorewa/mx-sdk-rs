{
    "name": "DRWA characterization: a named EGLD-payable endpoint remains callable when account metadata is nonpayable",
    "gasSchedule": "v3",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "sc:payable-features": {
                    "nonce": "0",
                    "balance": "0",
                    "code": "mxsc:../output/payable-features.mxsc.json",
                    "codeMetadata": "0x0000"
                },
                "address:drwa-funder": {
                    "nonce": "0",
                    "balance": "1,000"
                }
            }
        },
        {
            "step": "scCall",
            "id": "fund-named-intent",
            "tx": {
                "from": "address:drwa-funder",
