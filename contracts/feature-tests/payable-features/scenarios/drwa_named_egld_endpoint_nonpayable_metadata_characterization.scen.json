                "egldValue": "5",
                "function": "payable_egld_1",
                "arguments": [],
                "gasLimit": "50,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [
                    "5",
                    "str:EGLD"
                ],
                "status": "0",
                "logs": "*",
                "gas": "*",
                "refund": "*"
            }
        }
    ]
}
