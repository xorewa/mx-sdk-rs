{
    "name": "DRWA characterization: an EGLD-bearing async callback reaches a metadata-nonpayable contract",
    "steps": [
        {
            "step": "setState",
            "accounts": {
                "address:a_user": {
                    "nonce": "0",
                    "balance": "0"
                },
                "sc:vault": {
                    "nonce": "0",
                    "balance": "1000",
                    "code": "mxsc:../vault/output/vault.mxsc.json"
                },
                "sc:forwarder": {
                    "nonce": "0",
                    "balance": "0",
                    "code": "mxsc:../forwarder/output/forwarder.mxsc.json",
                    "codeMetadata": "0x0000"
                }
            }
        },
        {
            "step": "scCall",
            "id": "retrieve-through-callback",
            "tx": {
                "from": "address:a_user",
                "to": "sc:forwarder",
                "function": "forward_async_retrieve_funds",
                "arguments": [
                    "sc:vault",
                    "str:EGLD",
                    "0",
                    "1000"
                ],
                "gasLimit": "60,000,000",
                "gasPrice": "0"
            },
            "expect": {
                "out": [],
                "status": "0",
                "logs": "*",
                "gas": "*",
                "refund": "*"
            }
        },
        {
            "step": "checkState",
            "accounts": {
                "address:a_user": {
                    "nonce": "*",
                    "balance": "0",
                    "storage": {},
                    "code": ""
                },
                "sc:vault": {
                    "nonce": "0",
                    "balance": "0",
                    "storage": {},
                    "code": "mxsc:../vault/output/vault.mxsc.json"
                },
                "sc:forwarder": {
                    "nonce": "0",
                    "balance": "1000",
                    "storage": "*",
                    "code": "mxsc:../forwarder/output/forwarder.mxsc.json",
                    "codeMetadata": "0x0000"
                }
            }
        }
    ]
}
